# Oracle weight locations. Copy to oracles/env.sh and adjust if your layout
# differs, then source it. Defaults follow the layout in oracles/README.md.
#
#   cp oracles/env.sh.example oracles/env.sh
#   source oracles/env.sh
#
# Each variable is read lazily: a stage that does not need an oracle does not
# care whether it is set.

_ORACLES="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# regLM -- yeast promoter activity. $REGLM_REPO is placed on sys.path, so it
# must contain scripts/regression.py.
export REGLM_REPO="${REGLM_REPO:-$_ORACLES/reglm}"
export REGLM_YEAST_CKPT="${REGLM_YEAST_CKPT:-$REGLM_REPO/yeast_promoters/03_regression_separate/yeast_regression_separate_defined.ckpt}"

# GEMORNA -- human 5'UTR translational capacity.
export GEMORNA_5UTR_CKPT="${GEMORNA_5UTR_CKPT:-$_ORACLES/gemorna/checkpoints/5utr.pt}"

# PARM -- human promoter activity. This is the PARENT of the per-cell-type
# directories, not one of them.
export PARM_MODEL_DIR="${PARM_MODEL_DIR:-$_ORACLES/parm/pre_trained_models}"

# Malinois -- in-vitro MPRA enhancer activity.
export MALINOIS_DIR="${MALINOIS_DIR:-$_ORACLES/malinois}"
export MALINOIS_ARTIFACT="${MALINOIS_ARTIFACT:-$MALINOIS_DIR/MODELS-malinois_artifacts__20211113_021200__287348.tar.gz}"

unset _ORACLES
